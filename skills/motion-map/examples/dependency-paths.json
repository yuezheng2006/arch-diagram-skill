    {"id": "api", "x": 510, "y": 280, "w": 260, "h": 90, "title": "B · 接口层", "sub": "A 的直接依赖", "shape": "router", "color": "blue"},
    {"id": "database", "x": 960, "y": 280, "w": 260, "h": 90, "title": "C · 数据库", "sub": "B 的直接依赖", "shape": "store", "color": "purple"},
